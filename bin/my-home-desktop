#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  LINK_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$LINK_PATH" = /* ]] || LINK_PATH="$(dirname -- "$SCRIPT_PATH")/$LINK_PATH"
  SCRIPT_PATH="$LINK_PATH"
done
SCRIPT_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)"
ROOT_DIR="${MY_HOME_DESKTOP_ROOT:-$SCRIPT_ROOT}"
if [[ ! -f "$ROOT_DIR/server.mjs" && -f "$(dirname -- "$SCRIPT_PATH")/.project-root" ]]; then
  ROOT_DIR="$(<"$(dirname -- "$SCRIPT_PATH")/.project-root")"
fi
if [[ ! -f "$ROOT_DIR/server.mjs" ]]; then
  echo "找不到项目目录，请从项目内运行，或设置 MY_HOME_DESKTOP_ROOT。" >&2
  exit 1
fi
RUNTIME_DIR="${MY_HOME_DESKTOP_RUNTIME:-$HOME/Library/Application Support/My Home Desktop}"
PID_FILE="$RUNTIME_DIR/my-home-desktop.pid"
LOG_FILE="$RUNTIME_DIR/server.log"
PORT="${PORT:-3000}"
LAUNCHD_LABEL="com.myhomedesktop.launchd"

mkdir -p "$RUNTIME_DIR"

find_node() {
  local candidate major minor

  for candidate in "${NODE_BIN:-}" "$(command -v node 2>/dev/null || true)"; do
    if [[ -x "$candidate" ]]; then
      major="$("$candidate" -p 'process.versions.node.split(".")[0]' 2>/dev/null || true)"
      minor="$("$candidate" -p 'process.versions.node.split(".")[1]' 2>/dev/null || true)"
      if [[ "$major" =~ ^[0-9]+$ ]] && [[ "$minor" =~ ^[0-9]+$ ]] && { (( major > 20 )) || (( major == 20 && minor >= 19 )); }; then
        printf '%s\n' "$candidate"
        return 0
      fi
    fi
  done

  if [[ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]]; then
    # shellcheck disable=SC1090
    source "${NVM_DIR:-$HOME/.nvm}/nvm.sh"
    nvm use --silent 20 >/dev/null 2>&1 || true
    candidate="$(command -v node 2>/dev/null || true)"
    if [[ -x "$candidate" ]]; then
      major="$("$candidate" -p 'process.versions.node.split(".")[0]' 2>/dev/null || true)"
      minor="$("$candidate" -p 'process.versions.node.split(".")[1]' 2>/dev/null || true)"
      if [[ "$major" =~ ^[0-9]+$ ]] && [[ "$minor" =~ ^[0-9]+$ ]] && { (( major > 20 )) || (( major == 20 && minor >= 19 )); }; then
        printf '%s\n' "$candidate"
        return 0
      fi
    fi
  fi

  while IFS= read -r candidate; do
    if [[ -x "$candidate" ]]; then
      major="$("$candidate" -p 'process.versions.node.split(".")[0]' 2>/dev/null || true)"
      minor="$("$candidate" -p 'process.versions.node.split(".")[1]' 2>/dev/null || true)"
      if [[ "$major" =~ ^[0-9]+$ ]] && [[ "$minor" =~ ^[0-9]+$ ]] && { (( major > 20 )) || (( major == 20 && minor >= 19 )); }; then
        printf '%s\n' "$candidate"
        return 0
      fi
    fi
  done < <(find "${NVM_DIR:-$HOME/.nvm}/versions/node" -type f -path '*/bin/node' 2>/dev/null | sort -Vr)

  echo "找不到 Node.js 20.19 或更高版本。" >&2
  return 1
}

status() {
  local pid=""
  if [[ -f "$PID_FILE" ]]; then
    pid="$(<"$PID_FILE")"
  fi
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && command -v curl >/dev/null 2>&1 && curl -fsS --max-time 1 "http://localhost:$PORT/api/items" >/dev/null 2>&1; then
    echo "My Home Desktop 正在运行 (PID $pid)"
    echo "http://localhost:$PORT"
    return 0
  fi
  rm -f "$PID_FILE"
  echo "My Home Desktop 未运行"
  return 1
}

start() {
  if status >/dev/null 2>&1; then
    echo "My Home Desktop 已经在运行：http://localhost:$PORT"
    return 0
  fi
  local node_bin pid
  node_bin="$(find_node)"
  : >"$LOG_FILE"
  (
    cd "$ROOT_DIR"
    export PORT
    exec "$node_bin" server.mjs
  ) >>"$LOG_FILE" 2>&1 &
  pid=$!
  echo "$pid" >"$PID_FILE"
  for _ in {1..30}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid" 2>/dev/null || true
      rm -f "$PID_FILE"
      echo "启动失败，详见：$LOG_FILE" >&2
      return 1
    fi
    if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 1 "http://localhost:$PORT/api/items" >/dev/null 2>&1; then
      echo "My Home Desktop 已启动：http://localhost:$PORT"
      return 0
    fi
    sleep 0.1
  done
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
  echo "启动超时，详见：$LOG_FILE" >&2
  return 1
}

stop() {
  local launchd_running=0
  local pid_running=0
  if launchctl print "gui/$(id -u)/$LAUNCHD_LABEL" >/dev/null 2>&1; then
    if launchctl print "gui/$(id -u)/$LAUNCHD_LABEL" 2>/dev/null | grep -q 'state = running'; then
      launchd_running=1
      launchctl kill SIGTERM "gui/$(id -u)/$LAUNCHD_LABEL" 2>/dev/null || true
    fi
  fi

  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid="$(<"$PID_FILE")"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      pid_running=1
      kill "$pid" 2>/dev/null || true
      for _ in {1..20}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
      done
      if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
      fi
    fi
    rm -f "$PID_FILE"
  fi

  if (( launchd_running == 1 || pid_running == 1 )); then
    echo "My Home Desktop 已停止"
  else
    echo "My Home Desktop 未运行"
  fi
}

daemon() {
  local node_bin
  node_bin="$(find_node)"
  cd "$ROOT_DIR"
  export PORT
  exec "$node_bin" server.mjs >/dev/null 2>&1
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  open)
    start >/dev/null
    open "http://localhost:$PORT"
    ;;
  daemon) daemon ;;
  *)
    echo "用法：my-home-desktop {start|stop|restart|status|open}" >&2
    exit 2
    ;;
esac
